# Copy to .env.local and fill in. Everything is optional for local dev.

# Postgres (Neon/Supabase). Leave unset to use the built-in PGlite database in .data/pglite.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Better Auth: a long random string (openssl rand -base64 32) and the public URL of the app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (console.cloud.google.com → Credentials → OAuth client, web).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Magic-link email via Resend. Without it, links are printed to the server console.
# RESEND_API_KEY=
# EMAIL_FROM="CogniArena <login@yourdomain.com>"

# Comma-separated emails that get the admin role on sign-up.
# ADMIN_EMAILS=you@example.com
