{
  "name": "cogniarena",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:e2e": "pnpm --filter @cogniarena/web test:e2e",
    "db:generate": "pnpm --filter @cogniarena/db db:generate",
    "db:migrate": "pnpm --filter @cogniarena/db db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
